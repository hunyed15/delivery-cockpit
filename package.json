{
  "name": "@hunyed15/delivery-cockpit",
  "version": "0.2.0",
  "description": "Project delivery cockpit for DeepSeek Harness. One page answers where the project stands, what blocks it, what to do next and which capability to use; it also ships the independent Claude Code review engine and its typed tools (cockpit_report / cockpit_init / cockpit_acceptance / claude_review / claude_review_disposition / claude_review_install_hook). Writes only .dsh/plugin-state/; the review ledger stays in .trellis or .dsh/claude-review/ledger.",
  "license": "MIT",
  "author": "hunyed15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunyed15/delivery-cockpit.git"
  },
  "homepage": "https://github.com/hunyed15/delivery-cockpit#readme",
  "bugs": {
    "url": "https://github.com/hunyed15/delivery-cockpit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "delivery-cockpit",
    "delivery",
    "playbook",
    "trellis",
    "claude-code",
    "code-review",
    "acp"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*.js": "./lib/*.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "templates",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "docs/IMPLEMENTATION.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.106.0",
    "@agentclientprotocol/sdk": "^2.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
